{
  "name": "antigravity-tarot-script-gen",
  "version": "1.0.0",
  "description": "Semi-live YouTube tarot script generator for Tarot Light Path with Tim B.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9",
    "npm": ">=10.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "test:smoke": "MOCK_OPENAI=true next dev"
  },
  "dependencies": {
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@prisma/client": "7.2.0",
    "prisma": "7.2.0",
    "openai": "6.15.0",
    "zod": "4.3.5",
    "@t3-oss/env-nextjs": "^0.11.1",
    "tailwindcss": "4.1.18",
    "nanoid": "^5.0.0",
    "p-limit": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.1",
    "prettier": "^3.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  }
}
