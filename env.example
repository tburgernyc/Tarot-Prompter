# Environment variables for local development
# Copy this to .env.local and fill in your values

# === REQUIRED ===
OPENAI_API_KEY=sk-proj-your-key-here
DATABASE_URL=file:./dev.db
APP_PASSWORD=YourSuperSecurePassword123456789!
APP_COOKIE_SECRET=YourSuperSecureSecret123456789Key

# === OPTIONAL (defaults provided) ===
NODE_ENV=development
APP_COOKIE_TTL_DAYS=14
OPENAI_MODEL_PRIMARY=gpt-5.2-pro
OPENAI_MODEL_FAST=gpt-4o-mini
LOG_LEVEL=info
MOCK_OPENAI=false
MAX_COST_USD_PER_SESSION=2.50
WEB_SEARCH_CACHE_TTL_HOURS=24
NEXT_PUBLIC_APP_URL=http://localhost:3000
